{
  "name": "bouquine",
  "private": true,
  "version": "1.0.0",
  "description": "AI-powered creative writing assistant for novelists",
  "author": {
    "name": "Francis",
    "email": "francis@digital-factory.dev"
  },
  "repository": "https://github.com/ranmazoog/bouquine",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "test": "vitest",
    "build": "tsc -b && vite build",
    "build:mac": "npm run build && npx electron-builder --mac",
    "build:win": "npm run build && npx electron-builder --win",
    "build:linux": "npm run build && npx electron-builder --linux",
    "lint": "eslint .",
    "preview": "vite preview",
    "rebuild": "npx @electron/rebuild",
    "electron": "electron .",
    "start": "npm run build && electron ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@orama/orama": "^3.1.18",
    "@tiptap/extension-bubble-menu": "^3.15.3",
    "@tiptap/react": "^3.15.3",
    "@tiptap/starter-kit": "^3.15.3",
    "better-sqlite3": "^12.6.0",
    "docx": "^9.5.1",
    "electron-store": "^6.0.1",
    "epub-gen-memory": "^1.1.2",
    "html-to-docx": "^1.8.0",
    "lucide-react": "^0.562.0",
    "openai": "^6.16.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tiktoken": "^1.0.22",
    "zod": "^4.3.5",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/lodash": "^4.17.23",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "electron": "^40.0.0",
    "electron-builder": "^23.0.6",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.0.17"
  },
  "build": {
    "appId": "com.bouquine.app",
    "productName": "Bouquine",
    "copyright": "Copyright 2025 Bouquine",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build"
    },
    "files": [
      {
        "from": "dist",
        "to": "."
      },
      {
        "from": "dist-electron",
        "to": "."
      },
      {
        "from": "node_modules",
        "to": "node_modules"
      },
      "!node_modules/.cache"
    ]
  }
}
